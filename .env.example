# Copy this file's contents into Vercel -> Project -> Settings -> Environment
# Variables (or a local .env file for testing). Get these two values from
# Supabase Dashboard -> Project Settings -> API.
#
# IMPORTANT: only these two go here. The service-role key must NEVER be set
# as a VITE_ variable or added to Vercel as anything reachable by the
# frontend - it only belongs in Supabase Edge Function secrets.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
